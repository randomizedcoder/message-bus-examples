# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# MicroVM data disks (20GB each; regenerated by `k8s-start-all`)
*.img
k8s-*-data.img

# Cluster PKI dumped by `k8s-gen-certs` for inspection — contains
# private keys, never commit. Rebuilt from certs.nix at VM build time.
certs/

# Pre-generated application secrets live in ./secrets/ but are NOT
# gitignored here — Nix flakes can only read git-tracked files, so the
# gen-secrets script uses `git add -N` to make them visible to Nix
# without staging content. A pre-commit hook or review discipline
# prevents accidental commits. See docs/secrets.md.

# Chaos / failover test logs
chaos-logs/
chaos-logs-*/

# Integration smoke-test logs (pass/fail table + per-bus sub/pub captures)
integration-logs/

# Vendored Go dependencies. `go mod vendor` writes clients/vendor for local
# `go build`/`go test`/gopls, but it must NEVER be committed: Nix flakes read
# only git-tracked files, and buildGoModule reconstructs the same deps from
# `goVendorHash` — so a committed vendor/ makes buildGoModule refuse the hash
# ("vendor folder exists, please set 'vendorHash = null'") and drags 1971
# third-party files (some gofmt-dirty under newer Go) into every check.
clients/vendor/

# Stray compiled Go binaries left by a bare `go build` in the module. The
# real binaries only ever come from `nix build`/`nix run`; each is named
# after its leaf package directory. Listed explicitly so no source .go
# file can ever match.
clients/workloads/benchcli/benchcli
clients/nats/natscli/natscli
clients/rabbitmq/rabbitmqcli/rabbitmqcli
clients/mqtt/mqttcli/mqttcli
clients/valkey/valkeycli/valkeycli
clients/benchcli
